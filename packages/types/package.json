{
  "name": "@buildestate/types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript types and interfaces for BuildEstate platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@buildestate/config": "workspace:*",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  }
}
